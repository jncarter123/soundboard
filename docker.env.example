# cp docker.env.example docker.env — this is the file with the secrets in it.

# Where you reach the dashboard. Behind a reverse proxy this is the public URL,
# scheme included — the container only ever speaks plain http on 8080, so this
# is what tells the app it is an https site:
#
#   APP_URL=https://soundboard.example.com
#
# Get the scheme wrong and the browser blocks the dashboard's assets as mixed
# content, leaving an unstyled login page.
APP_URL=http://localhost:8000

# Leave blank and the first run generates one onto the volume and says so in
# the log. Set it here instead if you would rather hold the key yourself.
# Either way: it decrypts every stored Reverb app secret, so back it up, and
# never change it on an existing install.
APP_KEY=

# How long the running Reverb server keeps apps in memory before reloading
# them. Dashboard changes, including regenerated credentials, take effect
# within this many seconds.
REVERB_APPS_CACHE_TTL=10

# ---------------------------------------------------------------------------
# Alerts (see README): email and/or a signed webhook. Test with
#   docker compose exec app php artisan soundboard:test-alert
# ---------------------------------------------------------------------------
ALERTS_MAIL_TO=
ALERTS_WEBHOOK_URL=
# Required with a webhook: openssl rand -hex 32
ALERTS_WEBHOOK_SECRET=
ALERTS_CONNECTION_THRESHOLD=80
ALERTS_REMIND_MINUTES=60

# Mail, for ALERTS_MAIL_TO. "log" writes emails to the container log instead.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=soundboard@example.com
MAIL_FROM_NAME=Soundboard

# Audit log entries older than this many days are removed daily by the
# scheduler container.
ACTIVITYLOG_CLEAN_AFTER_DAYS=365

# ---------------------------------------------------------------------------
# MySQL / MariaDB instead of SQLite (optional)
# ---------------------------------------------------------------------------
# DB_CONNECTION=mysql        # or mariadb for MariaDB
# DB_HOST=mysql.example.internal
# DB_PORT=3306
# DB_DATABASE=soundboard
# DB_USERNAME=soundboard
# DB_PASSWORD=
